# Instalar programas descargados (.deb / .AppImage)
instalar() {
  local f="$1"
  if [ -z "$f" ]; then
    local dl; dl="$(xdg-user-dir DOWNLOAD 2>/dev/null || echo ~/Descargas)"
    f="$(ls -t "$dl"/*.deb "$dl"/*.AppImage "$dl"/*.appimage 2>/dev/null | head -1)"
    [ -z "$f" ] && { echo "No encontré .deb ni .AppImage en $dl"; return 1; }
    echo "Último descargado: $(basename "$f") ($(date -r "$f" '+%F %R'))"
  fi
  [ -f "$f" ] || { echo "No existe: $f"; return 1; }
  case "$f" in
    *.deb)
      # Se muestra qué es antes de instalarlo como root; por defecto, No.
      dpkg-deb -f "$f" Package Version Maintainer Homepage 2>/dev/null \
        || { echo "No es un .deb válido: $f"; return 1; }
      read -rp "¿Instalar con sudo? [s/N] " r
      [[ "$r" =~ ^[sSyY]$ ]] || return 0
      sudo apt install -y "$(realpath "$f")" ;;
    *.AppImage|*.appimage)
      mkdir -p ~/Aplicaciones
      local dest=~/Aplicaciones/"$(basename "$f")"
      cp "$f" "$dest" && chmod +x "$dest"
      echo "Listo: $dest"
      echo "Ejecútalo con: $dest" ;;
    *) echo "Formato no soportado: $f (solo .deb o .AppImage)" ;;
  esac
}

# Desinstalar por nombre (busca coincidencias si no es exacto)
desinstalar() {
  [ -z "$1" ] && { echo "Uso: desinstalar <nombre>"; return 1; }
  if dpkg -s "$1" &>/dev/null; then
    sudo apt remove -y "$1"
  else
    echo "No hay un paquete llamado '$1'. Coincidencias:"
    dpkg -l | awk '/^ii/ {print "  " $2}' | grep -i "$1" || echo "  (ninguna)"
  fi
}
