# Explorar archivos dentro de la terminal (sin salir de ella)

# Árbol de carpetas: arbol [carpeta] [niveles]
arbol() { eza --tree --icons --git-ignore -L "${2:-2}" "${1:-.}"; }

# Buscador con previsualización: explorar [carpeta]
#  - Markdown se ve con formato (glow), código con colores (bat), carpetas como árbol
#  - Escribe para filtrar, flechas para moverte, Esc para salir
#  - Enter abre el archivo completo (md con formato, código con colores); q vuelve a la lista
explorar() {
  ( cd "${1:-.}" || exit 1
    "${FD:-fd}" --hidden --exclude .git | fzf --height=100% \
      --preview 'if [ -d {} ]; then eza --tree --level=2 --icons --color=always {};
                 elif [[ {} == *.md ]]; then glow -s ~/.config/glow/estilo.json -w "${FZF_PREVIEW_COLUMNS:-80}" {};
                 else ${BAT:-bat} --color=always --style=numbers {}; fi' \
      --preview-window=right:65% \
      --bind 'enter:execute(if [ -d {} ]; then eza --tree --icons --color=always {} | less -R;
                            elif [[ {} == *.md ]]; then glow -p -s ~/.config/glow/estilo.json {};
                            else ${BAT:-bat} --color=always --style=numbers --paging=always {}; fi)' )
}

# Leer un Markdown con formato: md archivo.md  (q para salir)
md() { glow -p -s ~/.config/glow/estilo.json "$@"; }
